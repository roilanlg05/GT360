+            # 2. Intentar DELETE
+            print("2. Intentando DELETE...")
+            del_stmt = Delete(TripDB).Where(
+                (TripDB.id == uuid_id) & (TripDB.location_id == uuid_location_id)
+            )
+
+            result = await session.exec(del_stmt)
