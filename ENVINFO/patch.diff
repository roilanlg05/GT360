+            print(f"   - 1 Location (SDF)")
+            print(f"   - {trips_count} Trips")
+            print(f"   - {hotels_count} Hotels")
+            print()
+
+            respuesta = input("¿Continuar con la eliminación? (escribe 'SI' para confirmar): ")
