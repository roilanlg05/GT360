+└────────────────┬─────────────────────────┘
+                 │
+                 ▼
+┌──────────────────────────────────────────┐
+│ schedule-dashboard-client.tsx            │
+│ useEffect listener (lines 1971-2010)     │
+│ handleUploaded() triggers:               │
+└────────────────┬─────────────────────────┘
+                 │
+                 ├──────────────┬───────────────┐
+                 ▼              ▼               ▼
+        ┌────────────┐  ┌──────────┐  ┌────────────┐
+        │ 1. Reset   │  │ 2. Load  │  │ 3. Reconnect│
+        │   State    │  │   REST   │  │  WebSocket  │
+        └────┬───────┘  └────┬─────┘  └─────┬──────┘
+             │               │               │
+             ▼               ▼               ▼
+    ┌────────────┐  ┌───────────────┐  ┌──────────┐
+    │setRowsData │  │loadInitialTrips│  │wsReconnect│
+    │    ([])    │  │      ()        │  │    ()     │
+    └────────────┘  └───────────────┘  └──────┬────┘
+                            │                  │
+                            ▼                  ▼
+                    ┌───────────────┐  ┌─────────────┐
+                    │ REST loads    │  │ WS sends    │
+                    │ trips for     │  │ snapshot    │
+                    │ current month │  │ (ALL trips) │
+                    └───────┬───────┘  └──────┬──────┘
+                            │                 │
