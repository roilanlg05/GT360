+                    {action}
+                  </li>
+                ))}
+              </ul>
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+```
+
+### 3. Uso en el Upload Handler
+
+```typescript
+async function handleUpload(file: File, airport: string, airline: string) {
+  try {
+    const response = await uploadSchedule(file, airport, airline);
+
